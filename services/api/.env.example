# Banco de Dados PostgreSQL (Nuvem ou Local)
DATABASE_URL="postgresql://usuario:senha@host:5432/festflow_db?sslmode=require"

# Autenticação JWT
JWT_SECRET="sua_chave_secreta_jwt_longa_e_aleatoria"

# Porta do Servidor (no Render/Railway a porta é injetada automaticamente)
PORT=3000

# URL do Frontend (para CORS e redirecionamento da Stripe)
CLIENT_URL="http://localhost:5173"

# Pagamentos - Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLIC_KEY="pk_test_..."

# Pagamentos - Mercado Pago (opcional)
MP_ACCESS_TOKEN="APP_USR-..."
